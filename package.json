{
  "name": "pimess",
  "version": "0.1.0",
  "description": "Two-way iMessage routing for multiple Pi sessions",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "imessage", "macos"],
  "bin": {
    "pimess": "./bin/pimess.mjs"
  },
  "files": ["bin", "src", "photon", "README.md", "LICENSE", "docs"],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "spectrum-ts": "8.0.0",
    "typebox": "^1.3.7"
  },
  "overrides": {
    "protobufjs": "8.7.1",
    "@opentelemetry/otlp-transformer": "0.218.0",
    "@opentelemetry/otlp-exporter-base": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.218.0",
    "@opentelemetry/core": "2.10.0"
  },
  "pi": {
    "extensions": ["./src/extension.ts"]
  }
}
